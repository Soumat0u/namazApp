<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_kok"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/vakit_widget_arka"
    android:orientation="vertical"
    android:gravity="center_vertical"
    android:paddingStart="16dp"
    android:paddingEnd="14dp"
    android:paddingTop="10dp"
    android:paddingBottom="10dp">

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="☪" android:textColor="#FFD54F" android:textSize="13sp" />
        <TextView android:id="@+id/widget_vakit" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:layout_marginStart="6dp"
            android:text="TAKVA YOLUM" android:textColor="#E6FFFFFF" android:textSize="12sp" android:textStyle="bold" android:letterSpacing="0.12" android:maxLines="1" />
        <Chronometer android:id="@+id/widget_geri_sayim" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:background="@drawable/widget_hap" android:paddingStart="9dp" android:paddingEnd="9dp" android:paddingTop="2dp" android:paddingBottom="2dp"
            android:textColor="#FFD54F" android:textSize="12sp" android:textStyle="bold" />
    </LinearLayout>

    <TextView android:id="@+id/widget_saat" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp"
        android:text="--:--" android:textColor="#FFFFFF" android:textSize="32sp" android:fontFamily="sans-serif-light" android:includeFontPadding="false" />

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:gravity="center_vertical" android:orientation="horizontal">
        <ImageView android:id="@+id/nokta_0" android:layout_width="8dp" android:layout_height="8dp" android:layout_marginEnd="5dp" android:src="@drawable/widget_nokta_bos" />
        <ImageView android:id="@+id/nokta_1" android:layout_width="8dp" android:layout_height="8dp" android:layout_marginEnd="5dp" android:src="@drawable/widget_nokta_bos" />
        <ImageView android:id="@+id/nokta_2" android:layout_width="8dp" android:layout_height="8dp" android:layout_marginEnd="5dp" android:src="@drawable/widget_nokta_bos" />
        <ImageView android:id="@+id/nokta_3" android:layout_width="8dp" android:layout_height="8dp" android:layout_marginEnd="5dp" android:src="@drawable/widget_nokta_bos" />
        <ImageView android:id="@+id/nokta_4" android:layout_width="8dp" android:layout_height="8dp" android:layout_marginEnd="5dp" android:src="@drawable/widget_nokta_bos" />
        <TextView android:id="@+id/widget_alt" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="4dp"
            android:textColor="#CCFFFFFF" android:textSize="11sp" />
    </LinearLayout>
</LinearLayout>
