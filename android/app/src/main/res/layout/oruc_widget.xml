<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_kok"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/oruc_widget_arka"
    android:gravity="center_vertical"
    android:orientation="vertical"
    android:padding="14dp">

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
        <TextView android:id="@+id/oruc_ikon" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="🌙" android:textSize="13sp" />
        <TextView android:id="@+id/oruc_baslik" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:layout_marginStart="6dp"
            android:text="İFTARA KALAN" android:textColor="#FFD54F" android:textSize="11sp" android:textStyle="bold" android:letterSpacing="0.12" android:maxLines="1" />
    </LinearLayout>

    <Chronometer android:id="@+id/oruc_geri_sayim" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp"
        android:textColor="#FFFFFF" android:textSize="28sp" android:fontFamily="sans-serif-light" android:includeFontPadding="false" />

    <TextView android:id="@+id/oruc_saat" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp"
        android:text="--:--" android:textColor="#CCFFFFFF" android:textSize="12sp" />
</LinearLayout>
