<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_kok"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/vakit_widget_arka"
    android:orientation="vertical"
    android:padding="12dp">

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal" android:paddingStart="4dp" android:paddingEnd="2dp">
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="☪" android:textColor="#FFD54F" android:textSize="14sp" />
        <TextView android:id="@+id/widget_baslik" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:layout_marginStart="6dp"
            android:textColor="#FFFFFF" android:textSize="13sp" android:textStyle="bold" android:maxLines="1" />
        <Chronometer android:id="@+id/widget_geri_sayim" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:background="@drawable/widget_hap" android:paddingStart="9dp" android:paddingEnd="9dp" android:paddingTop="2dp" android:paddingBottom="2dp"
            android:textColor="#FFD54F" android:textSize="12sp" android:textStyle="bold" />
    </LinearLayout>

    <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:layout_marginTop="8dp" android:layout_marginBottom="6dp" android:orientation="horizontal">
        <LinearLayout android:id="@+id/kutu_0" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent"
            android:layout_marginStart="0dp" android:layout_marginEnd="3dp" android:background="@drawable/widget_kutu"
            android:gravity="center" android:orientation="vertical" android:paddingTop="4dp" android:paddingBottom="4dp">
            <TextView android:id="@+id/ad_0" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#CCFFFFFF" android:textSize="10sp" android:maxLines="1" />
            <TextView android:id="@+id/saat_0" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="1dp" android:textColor="#FFFFFF" android:textSize="14sp" android:textStyle="bold" android:maxLines="1" />
            <TextView android:id="@+id/isaret_0" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="1dp" android:textSize="11sp" android:textColor="#66FFFFFF" />
        </LinearLayout>
        <LinearLayout android:id="@+id/kutu_1" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent"
            android:layout_marginStart="3dp" android:layout_marginEnd="3dp" android:background="@drawable/widget_kutu"
            android:gravity="center" android:orientation="vertical" android:paddingTop="4dp" android:paddingBottom="4dp">
            <TextView android:id="@+id/ad_1" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#CCFFFFFF" android:textSize="10sp" android:maxLines="1" />
            <TextView android:id="@+id/saat_1" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="1dp" android:textColor="#FFFFFF" android:textSize="14sp" android:textStyle="bold" android:maxLines="1" />
            <TextView android:id="@+id/isaret_1" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="1dp" android:textSize="11sp" android:textColor="#66FFFFFF" />
        </LinearLayout>
        <LinearLayout android:id="@+id/kutu_2" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent"
            android:layout_marginStart="3dp" android:layout_marginEnd="3dp" android:background="@drawable/widget_kutu"
            android:gravity="center" android:orientation="vertical" android:paddingTop="4dp" android:paddingBottom="4dp">
            <TextView android:id="@+id/ad_2" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#CCFFFFFF" android:textSize="10sp" android:maxLines="1" />
            <TextView android:id="@+id/saat_2" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="1dp" android:textColor="#FFFFFF" android:textSize="14sp" android:textStyle="bold" android:maxLines="1" />
            <TextView android:id="@+id/isaret_2" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="1dp" android:textSize="11sp" android:textColor="#66FFFFFF" />
        </LinearLayout>
        <LinearLayout android:id="@+id/kutu_3" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent"
            android:layout_marginStart="3dp" android:layout_marginEnd="3dp" android:background="@drawable/widget_kutu"
            android:gravity="center" android:orientation="vertical" android:paddingTop="4dp" android:paddingBottom="4dp">
            <TextView android:id="@+id/ad_3" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#CCFFFFFF" android:textSize="10sp" android:maxLines="1" />
            <TextView android:id="@+id/saat_3" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="1dp" android:textColor="#FFFFFF" android:textSize="14sp" android:textStyle="bold" android:maxLines="1" />
            <TextView android:id="@+id/isaret_3" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="1dp" android:textSize="11sp" android:textColor="#66FFFFFF" />
        </LinearLayout>
        <LinearLayout android:id="@+id/kutu_4" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent"
            android:layout_marginStart="3dp" android:layout_marginEnd="3dp" android:background="@drawable/widget_kutu"
            android:gravity="center" android:orientation="vertical" android:paddingTop="4dp" android:paddingBottom="4dp">
            <TextView android:id="@+id/ad_4" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#CCFFFFFF" android:textSize="10sp" android:maxLines="1" />
            <TextView android:id="@+id/saat_4" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="1dp" android:textColor="#FFFFFF" android:textSize="14sp" android:textStyle="bold" android:maxLines="1" />
            <TextView android:id="@+id/isaret_4" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="1dp" android:textSize="11sp" android:textColor="#66FFFFFF" />
        </LinearLayout>
        <LinearLayout android:id="@+id/kutu_5" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent"
            android:layout_marginStart="3dp" android:layout_marginEnd="0dp" android:background="@drawable/widget_kutu"
            android:gravity="center" android:orientation="vertical" android:paddingTop="4dp" android:paddingBottom="4dp">
            <TextView android:id="@+id/ad_5" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#CCFFFFFF" android:textSize="10sp" android:maxLines="1" />
            <TextView android:id="@+id/saat_5" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="1dp" android:textColor="#FFFFFF" android:textSize="14sp" android:textStyle="bold" android:maxLines="1" />
            <TextView android:id="@+id/isaret_5" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="1dp" android:textSize="11sp" android:textColor="#66FFFFFF" />
        </LinearLayout>
    </LinearLayout>

    <TextView android:id="@+id/widget_alt" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center"
        android:textColor="#B3FFFFFF" android:textSize="11sp" />
</LinearLayout>
